# Setubandh AI — environment template (requirements §15.6).
# Copy to .env and fill in. Never commit real values.
# The typed config module (ticket M1-02) validates these at boot and refuses to start if one is missing.

NODE_ENV=development

# URLs
APP_URL=
ADMIN_URL=
API_URL=
HOOKS_URL=

# Data stores
DATABASE_URL=            # app role (orbit_app, NOBYPASSRLS)
DATABASE_ADMIN_URL=      # admin role (migrations, platform-admin only)
REDIS_URL=

# Object storage (S3 API: Cloudflare R2 in prod, local S3 container in dev)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Auth and encryption
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=          # AES-256-GCM key for Meta tokens and TOTP secrets; back up offline

# Meta platform
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=
META_ES_CONFIG_ID=       # Embedded Signup configuration ID

# AI (MVP 2)
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=claude-haiku-5-5
AI_MODEL_ESCALATION=claude-sonnet-5-5
EMBEDDINGS_PROVIDER=
EMBEDDINGS_API_KEY=

# Billing (M3)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Monitoring
SENTRY_DSN=
