# Setubandh AI — environment template (requirements §15.6, ticket M1-02).
# Create your local .env with `pnpm env:init` (fills local defaults and random secrets).
# Never commit .env. Every variable below is required at boot; `packages/env` validates them
# and refuses to start an app if one is missing or malformed. Only SMTP_USER, SMTP_PASS and
# SENTRY_DSN may be left empty (empty = no SMTP login / Sentry off).

# development | test | production
NODE_ENV=

# --- URLs (http/https) ---
# Tenant web app
APP_URL=
# Super Admin app
ADMIN_URL=
# REST API and WebSocket; its port is the API's listen port
API_URL=
# Public webhook host for Meta and billing providers
HOOKS_URL=

# --- Data stores ---
# App role orbit_app (NOBYPASSRLS), postgres://
DATABASE_URL=
# Admin role orbit_admin (migrations, platform-admin only), postgres://
DATABASE_ADMIN_URL=
# Valkey (Redis-compatible): queues, locks, cache, pub/sub; redis:// or rediss://
REDIS_URL=

# --- Object storage (S3 API: Cloudflare R2 in production, SeaweedFS locally) ---
# http(s) endpoint
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Auth and encryption ---
# At least 32 characters each
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 32 random bytes, base64. Encrypts Meta tokens and TOTP secrets (AES-256-GCM); back it up offline
ENCRYPTION_KEY=

# --- Meta platform (real values from ticket M1-08) ---
META_APP_ID=
META_APP_SECRET=
# Token you choose; Meta echoes it when verifying the webhook
META_VERIFY_TOKEN=
# Graph API version, e.g. v24.0
META_GRAPH_VERSION=
# Embedded Signup configuration ID
META_ES_CONFIG_ID=

# --- AI (MVP 2) ---
ANTHROPIC_API_KEY=
# Model IDs come from config, never code
AI_MODEL_DEFAULT=
AI_MODEL_ESCALATION=
EMBEDDINGS_PROVIDER=
EMBEDDINGS_API_KEY=

# --- Billing (M3) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Mailpit locally: 127.0.0.1:1025, inbox at http://localhost:8025) ---
# (The worker sends all email; the API only queues it.)
SMTP_HOST=
# 1-65535
SMTP_PORT=
# May be empty when the server needs no login
SMTP_USER=
SMTP_PASS=
# Sender, e.g. "Setubandh AI" <no-reply@yourdomain.com>
SMTP_FROM=

# --- Web push ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Monitoring ---
# May be empty (Sentry off)
SENTRY_DSN=
