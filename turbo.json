{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".nvmrc", "packages/config/tsconfig/*.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "../../packages/config/eslint/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "cache": false,
      "passThroughEnv": ["DOCKER_HOST", "TESTCONTAINERS_*"]
    },
    "test:browser": {
      "outputs": [],
      "env": ["PLAYWRIGHT_CHROMIUM_EXECUTABLE"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "env": [
        "CI",
        "E2E_BROWSERS",
        "E2E_UPDATE_SNAPSHOTS",
        "E2E_VIDEO",
        "PLAYWRIGHT_CHROMIUM_EXECUTABLE"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
