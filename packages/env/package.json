{
  "name": "@setubandh/env",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Server-only typed configuration: validates every environment variable (requirements \u00a715.6) at boot. Never import from web or admin.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "check": "node --conditions=source --import @swc-node/register/esm-register src/check.ts",
    "build": "swc src -d dist --strip-leading-paths --config-file ../../.swcrc --ignore '**/*.test.ts'"
  },
  "devDependencies": {
    "@setubandh/config": "workspace:*",
    "@setubandh/testing": "workspace:*",
    "@swc-node/register": "^1.12.1"
  },
  "dependencies": {
    "@setubandh/shared": "workspace:*"
  },
  "files": [
    "dist"
  ]
}
