{
  "name": "@setubandh/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations, RLS policies and the tenant-scoped db helper (M1-04).",
  "exports": {
    ".": {
      "@setubandh/source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "NODE_OPTIONS=--conditions=@setubandh/source drizzle-kit generate",
    "db:migrate": "node --conditions=@setubandh/source --import @swc-node/register/esm-register src/cli/migrate.ts",
    "db:seed": "node --conditions=@setubandh/source --import @swc-node/register/esm-register src/cli/seed.ts",
    "build": "swc src -d dist --strip-leading-paths --config-file ../../.swcrc --ignore '**/*.test.ts'",
    "db:migrate:prod": "node dist/cli/migrate.js"
  },
  "devDependencies": {
    "@setubandh/config": "workspace:*",
    "@setubandh/testing": "workspace:*",
    "@swc-node/register": "^1.12.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11"
  },
  "dependencies": {
    "@setubandh/env": "workspace:*",
    "@setubandh/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "^8.23.1",
    "uuidv7": "^1.2.1"
  },
  "files": [
    "dist",
    "migrations"
  ]
}
