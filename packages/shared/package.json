{
  "name": "@setubandh/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas, DTO types, enums, permission constants and error codes shared by API and UI.",
  "exports": {
    ".": {
      "@setubandh/source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "build": "swc src -d dist --strip-leading-paths --config-file ../../.swcrc --ignore '**/*.test.ts'"
  },
  "devDependencies": {
    "@setubandh/config": "workspace:*"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "zod": "^4.6.7"
  },
  "files": [
    "dist"
  ]
}
