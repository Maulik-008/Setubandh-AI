{
  "name": "@setubandh/channels",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Meta channel adapters: WhatsApp, Messenger, Instagram (send, parse, normalise).",
  "exports": {
    ".": {
      "@setubandh/source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "build": "swc src -d dist --strip-leading-paths --config-file ../../.swcrc --ignore '**/*.test.ts'"
  },
  "devDependencies": {
    "@setubandh/config": "workspace:*"
  },
  "files": [
    "dist"
  ]
}
