{
  "name": "setubandh-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "pnpm env:check && pnpm dev:services && turbo run dev",
    "dev:services": "docker compose --env-file .env -f infra/docker/docker-compose.dev.yml up -d --wait",
    "dev:services:down": "docker compose --env-file .env -f infra/docker/docker-compose.dev.yml down",
    "dev:services:reset": "node scripts/dev-services-reset.mjs",
    "env:init": "node scripts/env-init.mjs",
    "env:check": "pnpm --filter @setubandh/env check",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:browser": "turbo run test:browser",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
