{
  "name": "@setubandh/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tenant web app (React 19 + Vite).",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit --passWithNoTests",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.17",
    "@hookform/resolvers": "5.9.2",
    "@setubandh/shared": "workspace:*",
    "@setubandh/ui": "workspace:*",
    "@stylexjs/stylex": "0.19.2",
    "@tanstack/react-query": "5.108.4",
    "i18next": "27.2.7",
    "lucide-react": "1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "18.0.3",
    "react-router": "7.18.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.1",
    "@setubandh/config": "workspace:*",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "5.1.1",
    "msw": "^3.0.7",
    "playwright": "1.65.1",
    "tailwindcss": "4.3.5",
    "vite": "^8.3.8"
  }
}
