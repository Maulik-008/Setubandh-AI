{
  "name": "@setubandh/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS HTTP, WebSocket and webhook ingress (Fastify).",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "dev": "node --conditions=@setubandh/source --watch --import @swc-node/register/esm-register src/main.ts",
    "test:integration": "vitest run --project integration",
    "build": "swc src -d dist --strip-leading-paths --config-file ../../.swcrc --ignore '**/*.test.ts'",
    "start": "node --enable-source-maps dist/main.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/static": "^10.1.12",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-fastify": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "@node-rs/argon2": "2.2.2",
    "@setubandh/db": "workspace:*",
    "@setubandh/env": "workspace:*",
    "@setubandh/shared": "workspace:*",
    "fastify": "5.12.8",
    "ioredis": "^6.0.0",
    "jose": "6.2.18",
    "nestjs-pino": "^5.3.2",
    "nodemailer": "10.6.1",
    "otpauth": "9.6.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.6.0",
    "@setubandh/config": "workspace:*",
    "@setubandh/testing": "workspace:*",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "fast-check": "^4.11.0",
    "pino-pretty": "^13.2.0",
    "unplugin-swc": "^2.0.0"
  }
}
