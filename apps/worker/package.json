{
  "name": "@setubandh/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS standalone app running BullMQ processors and schedulers.",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "dev": "node --conditions=@setubandh/source --watch --import @swc-node/register/esm-register src/main.ts",
    "test:integration": "vitest run --project integration",
    "build": "swc src -d dist --strip-leading-paths --config-file ../../.swcrc --ignore '**/*.test.ts'",
    "start": "node --enable-source-maps dist/main.js"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@setubandh/db": "workspace:*",
    "@setubandh/env": "workspace:*",
    "@setubandh/shared": "workspace:*",
    "bullmq": "^6.7.8",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.2",
    "nodemailer": "10.6.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.6.0",
    "@setubandh/config": "workspace:*",
    "@setubandh/testing": "workspace:*",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@types/nodemailer": "^8.0.2",
    "unplugin-swc": "^2.0.0"
  }
}
